# === Payment mode ===
# USDC = Algorand TestNet (default, GoPlausible facilitator)
# EURQ or EURD = Algorand MainNet (Quantoz facilitator — requires KYC whitelist)
PAYMENT_ASSET=USDC

# === Algorand accounts (create with: npm run goal:accounts) ===
# Account 1 — Agent (pays x402)
AGENT_MNEMONIC=
AGENT_ADDRESS=
AGENT_AVM_PRIVATE_KEY=

# Account 2 — Merchant (receives x402)
MERCHANT_MNEMONIC=
MERCHANT_ADDRESS=
MERCHANT_AVM_PRIVATE_KEY=
RESOURCE_PAY_TO=

# === Quantoz EUR (Path: Quantoz managed account — hackathon bonus) ===
QUANTOZ_API_KEY=
QUANTOZ_ACCOUNT=

# Facilitator (auto-selected by PAYMENT_ASSET if unset)
# TestNet USDC: https://facilitator.goplausible.xyz
# Quantoz EUR:  https://x402algo.ai.quantozpay.com
FACILITATOR_URL=

ALGOD_URL=https://testnet-api.algonode.cloud
ALGOD_TOKEN=

# true = simulated payments | false = live x402
DEMO_MODE=true

MAX_DAILY_SPEND_USD=10
MAX_SINGLE_TX_USD=5
MAX_API_SPEND_USD=1

API_PORT=4021
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4021
